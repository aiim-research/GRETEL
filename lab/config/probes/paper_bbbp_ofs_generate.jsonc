// First real-data pilot: BBBP molecules with the thesis GCN oracle (do-pair
// BBBP_GCN). OFS edits bonds of the molecule itself, so no padding is needed;
// LocalSearch without attributes minimizes the bond edits. OracleView drops
// what the GCN never reads (bond features, SMILES/RDKit graph features), and
// the molecule order is seeded so cached splits and oracle stay valid. 40
// stratified splits without shuffle: fold 0 holds ~51 held-out molecules, and
// the oracle is trained on the other 39 folds, so its logged test accuracy is
// on the explained instances.
{
  "experiment": {"scope": "paper-probes-bbbp-ofs", "parameters": {"lock_release_tout": 120}},
  "doe-triplets": [
    {
      "dataset": {
        "class": "src.dataset.dataset_base.Dataset",
        "parameters": {
          "generator": {
            "class": "src.dataset.generators.mol_seeded.SeededMolGenerator",
            "parameters": {"data_dir": "data/datasets/bbbp/", "data_file_name": "BBBP.csv", "data_label_name": "p_np", "seed": 0}
          },
          "n_splits": 40,
          "shuffle": false,
          "manipulators": [{"class": "src.dataset.manipulators.oracle_view.OracleView", "parameters": {}}]
        }
      },
      "oracle": {
        "class": "src.oracle.nn.torch.OracleTorch",
        "parameters": {
          "fold_id": 0, "retrain": false, "epochs": 1000, "batch_size": 64,
          "optimizer": {"class": "torch.optim.RMSprop", "parameters": {"lr": 0.001, "momentum": 0.5}},
          "loss_fn": {"class": "torch.nn.CrossEntropyLoss", "parameters": {"reduction": "mean"}},
          "model": {"class": "src.oracle.nn.gcn.DownstreamGCN",
                    "parameters": {"num_conv_layers": 2, "num_dense_layers": 1, "conv_booster": 2, "linear_decay": 1.8}}
        }
      },
      "compose_dataset_info": "lab/config/snippets/dataset_infos/bbbp.json",
      "explainer": {
        "class": "src.explainer.future.meta.generate_minimize.GenerateMinimize",
        "parameters": {
          "fold_id": 0,
          "generator": {"class": "src.explainer.future.search.ofs.OFS", "parameters": {"seed": 0}},
          "minimizer": {
            "class": "src.explainer.future.metaheuristic.local_search.local_search.LocalSearch",
            "parameters": {"neigh_factor": 4, "runtime_factor": 4, "max_runtime": 20, "max_neigh": 20,
                           "attributed": false, "seed": 0, "recompute_features": false}
          }
        }
      }
    }
  ],
  "evaluator": {"class": "src.evaluation.future.evaluator.Evaluator", "parameters": {"compose_pip": "lab/config/snippets/paper_generation_pipeline.json"}},
  "compose_strs": "lab/config/snippets/default_store_paths.json"
}

// Minimizer comparison on the narrative pairs of aids (protocol v2): the pairs config with minimizer 'bls-edges' and the
// edit-cost stages instead of the narrative stages. Same dataset, oracle and DCE seed (shared generator cache) for every arm.
{
  "experiment": {
    "scope": "cmp-aids_dce_bls-edges",
    "parameters": {
      "lock_release_tout": 120
    }
  },
  "doe-triplets": [
    {
      "dataset": {
        "class": "src.dataset.dataset_base.Dataset",
        "parameters": {
          "generator": {
            "class": "src.dataset.generators.TUDataset.TUDataset",
            "parameters": {
              "alias": "AIDS"
            }
          },
          "n_splits": 20,
          "shuffle": false,
          "manipulators": [
            {
              "class": "src.dataset.manipulators.isolated.DeleteIsolatedNodes",
              "parameters": {}
            },
            {
              "class": "src.dataset.manipulators.oracle_view.OracleView",
              "parameters": {}
            },
            {
              "class": "src.dataset.manipulators.feature_names.FeatureNames",
              "parameters": {
                "names": [
                  "chem",
                  "charge",
                  "x",
                  "y",
                  "C",
                  "O",
                  "N",
                  "Cl",
                  "F",
                  "S",
                  "Se",
                  "P",
                  "Na",
                  "I",
                  "Co",
                  "Br",
                  "Li",
                  "Si",
                  "Mg",
                  "Cu",
                  "As",
                  "B",
                  "Pt",
                  "Ru",
                  "K",
                  "Pd",
                  "Au",
                  "Te",
                  "W",
                  "Rh",
                  "Zn",
                  "Bi",
                  "Pb",
                  "Ge",
                  "Sb",
                  "Sn",
                  "Ga",
                  "Hg",
                  "Ho",
                  "Tl",
                  "Ni",
                  "Tb"
                ]
              }
            }
          ]
        }
      },
      "oracle": {
        "class": "src.oracle.nn.torch.OracleTorch",
        "parameters": {
          "fold_id": 0,
          "retrain": false,
          "epochs": 400,
          "batch_size": 32,
          "optimizer": {
            "class": "torch.optim.RMSprop",
            "parameters": {
              "lr": 0.01
            }
          },
          "loss_fn": {
            "class": "torch.nn.CrossEntropyLoss",
            "parameters": {
              "reduction": "mean"
            }
          },
          "model": {
            "class": "src.oracle.nn.gcn.DownstreamGCN",
            "parameters": {
              "num_conv_layers": 3,
              "num_dense_layers": 1,
              "conv_booster": 2,
              "linear_decay": 1.8,
              "exact_conv_layers": true
            }
          }
        }
      },
      "compose_dataset_info": "lab/config/snippets/dataset_infos/aids.json",
      "explainer": {
        "class": "src.explainer.future.meta.generate_minimize.GenerateMinimize",
        "parameters": {
          "fold_id": 0,
          "generator": {
            "class": "src.explainer.future.search.dces.DCESExplainer",
            "parameters": {
              "projection": "assignment"
            }
          },
          "minimizer": {
            "class": "src.explainer.future.metaheuristic.local_search.local_search.LocalSearch",
            "parameters": {
              "neigh_factor": 4,
              "runtime_factor": 4,
              "max_runtime": 20,
              "max_neigh": 20,
              "seed": 0,
              "attributed": false
            }
          },
          "generator_cache": "lab/data/cache/generator_outputs"
        }
      }
    }
  ],
  "evaluator": {
    "class": "src.evaluation.future.evaluator.Evaluator",
    "parameters": {
      "pipeline": {
        "class": "src.evaluation.future.stages.main_pipeline.MainPipeline",
        "parameters": {
          "stages": [
            {
              "class": "src.evaluation.future.stages.runtime.Runtime",
              "parameters": {}
            },
            {
              "class": "src.evaluation.future.stages.correctness.Correctness",
              "parameters": {}
            },
            {
              "class": "src.evaluation.future.stages.ged.GraphEditDistance",
              "parameters": {}
            },
            {
              "class": "src.evaluation.future.stages.edit_distance.EditDistance",
              "parameters": {}
            },
            {
              "class": "src.evaluation.future.stages.edit_distance.StructuralEditDistance",
              "parameters": {}
            },
            {
              "class": "src.evaluation.future.stages.edit_distance.MatchedFeatureDistance",
              "parameters": {}
            },
            {
              "class": "src.evaluation.future.stages.oracle_calls.OracleCalls",
              "parameters": {}
            }
          ]
        }
      }
    }
  },
  "compose_strs": "lab/config/snippets/default_store_paths.json"
}

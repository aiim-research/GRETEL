{
  "scope": "narr-v0",
  "arms": [
    "minimized",
    "seed",
    "random_subset"
  ],
  "sample_per_source": 20,
  "model_defaults": {
    "engine": "vllm",
    "dtype": "bfloat16",
    "temperature": 0.7,
    "top_p": 0.95,
    "seed": 0,
    "max_new_tokens": 1024,
    "enable_thinking": false,
    "gpu_memory_utilization": 0.75,
    "max_model_len": 32768,
    "max_num_seqs": 64,
    "local_files_only": true
  },
  "slurm": {
    "partition": "cuda",
    "gres": "gpu:fast:1",
    "parallel": true,
    "time": "1-00:00:00",
    "mem": "96G",
    "min_free_mb": 70000,
    "max_wait": 21600,
    "env": "GRTL-llm"
  },
  "generators": [

        "reasoning_effort": "low"
      }
    }
  ],
  "probes": {
    "reconstruction": {
      "feature_match": "transition",
      "arms": [
        "minimized"
      ],
      "conditions": [
        {
          "context": "off",
          "mode": "dict"
        },
        {
          "context": "on",
          "mode": "dict"
        }
      ]
    },
    "consistency": {
      "arms": [
        "minimized"
      ],
      "conditions": [
        {
          "test": "inversion",
          "mode": "dict"
        },
        {
          "test": "renaming",
          "mode": "dict"
        },
        {
          "test": "identity",
          "mode": "dict"
        }
      ]
    },
    "recourse": {
      "arms": [
        "minimized"
      ],
      "control": true,
      "success": "target",
      "preprocess": true,
      "feature_match": "transition",
      "conditions": [
        {
          "context": "off",
          "mode": "dict",
          "budget": "record"
        }
      ]
    }
  }

        "seed",
        "minimized"
      ],
      "conditions": [
        {
          "test": "inversion",
          "mode": "dict"
        },
        {
          "test": "renaming",
          "mode": "dict"
        },
        {
          "test": "identity",
          "mode": "dict"
        }
      ]
    },
    "recourse": {
      "arms": [
        "seed",
        "minimized"
      ],
      "control": true,
      "success": "target",
      "preprocess": true,
      "feature_match": "transition",
      "conditions": [
        {
          "context": "off",
          "mode": "dict",
          "budget": "record"
        }
      ]
    }
  },
  "self_evaluation": {

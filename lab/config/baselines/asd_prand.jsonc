{
    // pRand baseline on ASD, in the current pipeline.
    // The method itself is src/explainer/search/p_rand.py (GRETEL v2); the
    // class named here is the future/ wrapper that returns an Explanation.
    "experiment": {
        "scope": "baseline_asd_prand",
        "parameters": {
            "lock_release_tout": 120,
            "propagate": [
                {"in_sections": ["doe-triplets/explainer"], "params": {"fold_id": 0}},
                {"in_sections": ["doe-triplets/oracle"], "params": {"fold_id": -1, "retrain": false}}
            ],
            "expand": {"folds": ["doe-triplets/explainer"], "triplets": true}
        }
    },
    "doe-triplets": [
        {
            "compose_do": "./lab/config/snippets/do-pairs/ASD_ASD-Custom.json",
            "explainer": {
                "class": "src.explainer.future.search.p_rand.PRandExplainer",
                "parameters": {"p": 0.01, "t": 3}
            }
        }
    ],
    "evaluator": {
        "class": "src.evaluation.future.evaluator.Evaluator",
        "parameters": {"compose_pip": "./lab/config/snippets/default_pipeline.json"}
    },
    "compose_strs": "./lab/config/snippets/default_store_paths.json"
}

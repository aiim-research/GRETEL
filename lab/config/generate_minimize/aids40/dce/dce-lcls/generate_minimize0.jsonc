{
    "experiment": {
        "scope": "aids40_dce_lcls",
        "parameters": {
            "lock_release_tout": 120,
            "propagate": [
                {
                    "in_sections": [
                        "doe-triplets/explainer"
                    ],
                    "params": {
                        "fold_id": 0
                    }
                },
                {
                    "in_sections": [
                        "doe-triplets/oracle"
                    ],
                    "params": {
                        "fold_id": -1,
                        "retrain": false
                    }
                },
                {
                    "in_sections": [
                        "doe-triplets/dataset"
                    ],
                    "params": {
                        "compose_man": "lab/config/snippets/datasets/padding.json"
                    }
                }
            ],
            "expand": {
                "folds": [
                    "doe-triplets/explainer"
                ],
                "triplets": true
            }
        }
    },
    "doe-triplets": [
        {
            "compose_do": "./lab/config/snippets/do-pairs/AIDS_GCN.json",
            "explainer": {
                "class": "src.explainer.future.meta.generate_minimize.GenerateMinimize",
                "parameters": {
                    "fold_id": 0,
                    "generator": {
                        "class": "src.explainer.future.search.dces.DCESExplainer",
                        "parameters": {
                            "epochs": 500
                        }
                    },
                    "minimizer": {
                        "class": "src.explainer.future.metaheuristic.local_search.local_search.LocalSearch",
                        "parameters": {
                            "neigh_factor": 4,
                            "runtime_factor": 4,
                            "max_runtime": 20,
                            "max_neigh": 20,
                            "attributed": true,
                            "seed": 0,
                            "max_oracle_calls": 2000,
                            "strict_budget": true
                        }
                    },
                    "generator_cache": "lab/data/cache/generator_outputs"
                }
            }
        }
    ],
    "evaluator": {
        "class": "src.evaluation.future.evaluator.Evaluator",
        "parameters": {
            "compose_pip": "./lab/config/snippets/minimizing_pipeline.json",
            "instance_ids": [
                3,
                19,
                176,
                181,
                184,
                210,
                224,
                247,
                266,
                462,
                506,
                555,
                569,
                640,
                747,
                748,
                802,
                823,
                848,
                880,
                931,
                958,
                1013,
                1034,
                1156,
                1184,
                1221,
                1349,
                1366,
                1419,
                1442,
                1520,
                1583,
                1600,
                1658,
                1663,
                1728,
                1874,
                1911,
                1971
            ]
        }
    },
    "compose_strs": "./lab/config/snippets/default_store_paths.json"
}

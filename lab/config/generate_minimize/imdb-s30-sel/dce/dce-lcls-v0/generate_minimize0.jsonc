{
    "experiment": {
        "scope": "imdb-s30-sel_dce_lcls-v0",
        "parameters": {
            "lock_release_tout": 120,
            "propagate": [
                {
                    "in_sections": [
                        "doe-triplets/explainer"
                    ],
                    "params": {
                        "fold_id": 0
                    }
                },
                {
                    "in_sections": [
                        "doe-triplets/oracle"
                    ],
                    "params": {
                        "fold_id": -1,
                        "retrain": false
                    }
                },
                {
                    "in_sections": [
                        "doe-triplets/dataset"
                    ],
                    "params": {
                        "compose_man": "lab/config/snippets/datasets/padding_and_degree.json"
                    }
                }
            ],
            "expand": {
                "folds": [
                    "doe-triplets/explainer"
                ],
                "triplets": true
            }
        }
    },
    "doe-triplets": [
        {
            "compose_do": "./lab/config/snippets/do-pairs/IMDB-Binary-deg_GCN.json",
            "explainer": {
                "class": "src.explainer.future.meta.generate_minimize.GenerateMinimize",
                "parameters": {
                    "fold_id": 0,
                    "generator": {
                        "class": "src.explainer.future.search.dces.DCESExplainer",
                        "parameters": {
                            "epochs": 500
                        }
                    },
                    "minimizer": {
                        "class": "src.explainer.future.metaheuristic.local_search.local_search.LocalSearch",
                        "parameters": {
                            "neigh_factor": 4,
                            "runtime_factor": 4,
                            "max_runtime": 20,
                            "max_neigh": 20,
                            "seed": 0,
                            "max_oracle_calls": 10000,
                            "strict_budget": true,
                            "stop_after_failed_iteration": true,
                            "attribute_methods": [
                                "identity",
                                "average_smoothing",
                                "weighted_smoothing",
                                "laplacian_regularization",
                                "feature_aggregation",
                                "heat_kernel_diffusion",
                                "random_walk_diffusion"
                            ]
                        }
                    },
                    "generator_cache": "lab/data/cache/generator_outputs"
                }
            }
        }
    ],
    "evaluator": {
        "class": "src.evaluation.future.evaluator.Evaluator",
        "parameters": {
            "compose_pip": "./lab/config/snippets/minimizing_pipeline.json",
            "instance_ids": [
                9,
                24,
                33,
                90,
                137,
                144,
                157,
                165,
                184,
                250,
                272,
                288,
                450,
                463,
                505,
                561,
                574,
                575,
                630,
                632,
                669,
                711,
                885,
                892,
                895,
                916,
                949,
                958,
                982,
                997
            ]
        }
    },
    "compose_strs": "./lab/config/snippets/default_store_paths.json"
}

{
    "experiment": {
        "scope": "colors340_dce_lcls-net",
        "parameters": {
            "lock_release_tout": 120,
            "propagate": [
                {
                    "in_sections": [
                        "doe-triplets/explainer"
                    ],
                    "params": {
                        "fold_id": 0
                    }
                },
                {
                    "in_sections": [
                        "doe-triplets/oracle"
                    ],
                    "params": {
                        "fold_id": -1,
                        "retrain": false
                    }
                },
                {
                    "in_sections": [
                        "doe-triplets/dataset"
                    ],
                    "params": {
                        "compose_man": "lab/config/snippets/datasets/padding.json"
                    }
                }
            ],
            "expand": {
                "folds": [
                    "doe-triplets/explainer"
                ],
                "triplets": true
            }
        }
    },
    "doe-triplets": [
        {
            "compose_do": "./lab/config/snippets/do-pairs/COLORS-3_GCN.json",
            "explainer": {
                "class": "src.explainer.future.meta.generate_minimize.GenerateMinimize",
                "parameters": {
                    "fold_id": 0,
                    "generator": {
                        "class": "src.explainer.future.search.dces.DCESExplainer",
                        "parameters": {
                            "epochs": 500
                        }
                    },
                    "minimizer": {
                        "class": "src.explainer.future.metaheuristic.local_search.local_search_selection_net.LocalSearch",
                        "parameters": {
                            "neigh_factor": 4,
                            "runtime_factor": 4,
                            "max_runtime": 20,
                            "max_neigh": 20,
                            "attributed": true,
                            "max_oracle_calls": 2000,
                            "seed": 0,
                            "monitor": true
                        }
                    },
                    "generator_cache": "lab/data/cache/generator_outputs"
                }
            }
        }
    ],
    "evaluator": {
        "class": "src.evaluation.future.evaluator.Evaluator",
        "parameters": {
            "compose_pip": "./lab/config/snippets/minimizing_pipeline.json",
            "instance_ids": [
                46,
                188,
                463,
                1628,
                1740,
                2006,
                2020,
                2121,
                2192,
                2338,
                2513,
                2936,
                4040,
                4301,
                4720,
                4892,
                5561,
                5565,
                5647,
                5999,
                6094,
                6186,
                6716,
                6890,
                7037,
                7155,
                7263,
                7482,
                7872,
                7926,
                8623,
                8665,
                8936,
                9117,
                9259,
                9382,
                10069,
                10071,
                10227,
                10466
            ]
        }
    },
    "compose_strs": "./lab/config/snippets/default_store_paths.json"
}

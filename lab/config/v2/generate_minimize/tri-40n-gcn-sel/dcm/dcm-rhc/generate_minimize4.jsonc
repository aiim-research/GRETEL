// Protocol v2 DCEM arm of the selector paper, generated by scripts/gen_v2_configs.py from lab/config/generate_minimize/tri-40n-gcn-sel/dce/dce-lcls-v0/generate_minimize4.jsonc: do not edit.
{
    "experiment": {
        "scope": "v2-tri-40n-gcn-sel_dcm_rhc",
        "parameters": {
            "lock_release_tout": 120,
            "propagate": [
                {
                    "in_sections": [
                        "doe-triplets/explainer"
                    ],
                    "params": {
                        "fold_id": 4
                    }
                },
                {
                    "in_sections": [
                        "doe-triplets/oracle"
                    ],
                    "params": {
                        "fold_id": -1,
                        "retrain": false
                    }
                },
                {
                    "in_sections": [
                        "doe-triplets/dataset"
                    ],
                    "params": {
                        "compose_man": "lab/config/v2/snippets/datasets/triangles-delete-isolated.json"
                    }
                }
            ],
            "expand": {
                "folds": [
                    "doe-triplets/explainer"
                ],
                "triplets": true
            }
        }
    },
    "doe-triplets": [
        {
            "compose_do": "./lab/config/v2/snippets/do-pairs/TRI-500-40n_GCN.json",
            "explainer": {
                "class": "src.explainer.future.meta.generate_minimize.GenerateMinimize",
                "parameters": {
                    "fold_id": 4,
                    "generator": {
                        "class": "src.explainer.future.search.dcm.DCM",
                        "parameters": {
                            "epochs": 500,
                            "projection": "assignment",
                            "classify_with": "oracle"
                        }
                    },
                    "minimizer": {
                        "class": "src.explainer.future.metaheuristic.local_search.random_hill_climbing.RandomHillClimbing",
                        "parameters": {
                            "manip_attr": false,
                            "max_oracle_calls": 10000,
                            "patience": 40,
                            "seed": 0,
                            "attributed": false
                        }
                    },
                    "generator_cache": "lab/data/cache/generator_outputs",
                    "fallback_scan": true
                }
            }
        }
    ],
    "evaluator": {
        "class": "src.evaluation.future.evaluator.Evaluator",
        "parameters": {
            "compose_pip": "./lab/config/v2/snippets/minimizing_pipeline.json"
        }
    },
    "compose_strs": "./lab/config/v2/snippets/default_store_paths.json"
}

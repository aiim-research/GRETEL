    "experiment": {
        "scope": "v2-asd_dce_lcls_seed3",
        "parameters": {
            "lock_release_tout": 120,
            "propagate": [
                {
                    "in_sections": [
                        "doe-triplets/explainer"
                    ],
                    "params": {
                        "fold_id": 3
                    }
                },
                {
                    "in_sections": [
                        "doe-triplets/oracle"
                    ],
                    "params": {
                        "fold_id": -1,
                        "retrain": false

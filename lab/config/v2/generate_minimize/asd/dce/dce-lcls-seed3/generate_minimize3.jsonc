                                "identity",
                                "average_smoothing",
                                "weighted_smoothing",
                                "laplacian_regularization",
                                "feature_aggregation",
                                "heat_kernel_diffusion",
                                "random_walk_diffusion"
                            ],
                            "neigh_factor": 4,
                            "runtime_factor": 4,
                            "max_runtime": 20,
                            "max_neigh": 20,
                            "seed": 3,
                            "recompute_features": false
                        }
                    },
                    "generator_cache": "lab/data/cache/generator_outputs"
                }
            }
        }
    ],
    "evaluator": {
        "class": "src.evaluation.future.evaluator.Evaluator",
        "parameters": {

                    ],
                    "params": {
                        "compose_man": "lab/config/v2/snippets/datasets/empty.json"
                    }
                }
            ],
            "expand": {
                "folds": [
                    "doe-triplets/explainer"
                ],
                "triplets": true
            }
        }
    },
    "doe-triplets": [
        {
            "compose_do": "./lab/config/v2/snippets/do-pairs/ASD_ASD-Custom.json",
            "explainer": {
                "class": "src.explainer.future.meta.generate_minimize.GenerateMinimize",
                "parameters": {
                    "fold_id": 1,
                    "generator": {
                        "class": "src.explainer.future.search.dces.DCESExplainer",
                        "parameters": {
                            "epochs": 500,
                            "projection": "assignment"
                        }
                    },
                    "minimizer": {
                        "class": "src.explainer.future.metaheuristic.local_search.local_search.LocalSearch",
                        "parameters": {
                            "stop_after_failed_iteration": true,

// Protocol v2 arm E of the selector paper, generated by scripts/gen_v2_configs.py from lab/config/generate_minimize/aids-sel/dce/dce-lcls-v0/generate_minimize5.jsonc: do not edit.
{
    "experiment": {
        "scope": "v2-aids-sel_dfs_dbs",
        "parameters": {
            "lock_release_tout": 120,
            "propagate": [
                {
                    "in_sections": [
                        "doe-triplets/explainer"
                    ],
                    "params": {
                        "fold_id": 5
                    }
                },
                {
                    "in_sections": [
                        "doe-triplets/oracle"
                    ],
                    "params": {
                        "fold_id": -1,
                        "retrain": false
                    }
                },
                {
                    "in_sections": [
                        "doe-triplets/dataset"
                    ],
                    "params": {
                        "compose_man": "lab/config/v2/snippets/datasets/padding-delete-isolated.json"
                    }
                }
            ],
            "expand": {
                "folds": [
                    "doe-triplets/explainer"
                ],
                "triplets": true
            }
        }
    },
    "doe-triplets": [
        {
            "compose_do": "./lab/config/v2/snippets/do-pairs/AIDS_GCN.json",
            "explainer": {
                "class": "src.explainer.future.meta.generate_minimize.GenerateMinimize",
                "parameters": {
                    "fold_id": 5,
                    "generator": {
                        "class": "src.explainer.future.search.dfs.DFS",
                        "parameters": {
                            "max_oc": 2000,
                            "changes_batch_size": 5,
                            "random_seed": 0,
                            "prior": "type_pair",
                            "node_type": {
                                "kind": "columns",
                                "columns": [
                                    4,
                                    42
                                ]
                            },
                            "normalize": true
                        }
                    },
                    "minimizer": {
                        "class": "src.explainer.future.meta.minimizer.dbs.DBS",
                        "parameters": {
                            "max_oc": 4000,
                            "changes_batch_size": 5,
                            "random_seed": 0,
                            "prior": "type_pair",
                            "node_type": {
                                "kind": "columns",
                                "columns": [
                                    4,
                                    42
                                ]
                            },
                            "normalize": true
                        }
                    },
                    "generator_cache": "lab/data/cache/generator_outputs"
                }
            }
        }
    ],
    "evaluator": {
        "class": "src.evaluation.future.evaluator.Evaluator",
        "parameters": {
            "compose_pip": "./lab/config/v2/snippets/minimizing_pipeline.json"
        }
    },
    "compose_strs": "./lab/config/v2/snippets/default_store_paths.json"
}

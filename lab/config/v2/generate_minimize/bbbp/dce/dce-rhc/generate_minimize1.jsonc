// Protocol v2, generated by scripts/gen_v2_configs.py from lab/config/generate_minimize/bbbp/dce/dce-rhc/generate_minimize1.jsonc: do not edit.
{
    "experiment": {
        "scope": "v2-bbbp_dce_rhc",
        "parameters": {
            "lock_release_tout": 120,
            "propagate": [
                {
                    "in_sections": [
                        "doe-triplets/explainer"
                    ],
                    "params": {
                        "fold_id": 1
                    }
                },
                {
                    "in_sections": [
                        "doe-triplets/oracle"
                    ],
                    "params": {
                        "fold_id": -1,
                        "retrain": false
                    }
                },
                {
                    "in_sections": [
                        "doe-triplets/dataset"
                    ],
                    "params": {
                        "compose_man": "lab/config/v2/snippets/datasets/padding.json"
                    }
                }
            ],
            "expand": {
                "folds": [
                    "doe-triplets/explainer"
                ],
                "triplets": true
            }
        }
    },
    "doe-triplets": [
        {
            "compose_do": "./lab/config/v2/snippets/do-pairs/BBBP_GCN.json",
            "explainer": {
                "class": "src.explainer.future.meta.generate_minimize.GenerateMinimize",
                "parameters": {
                    "fold_id": 1,
                    "generator": {
                        "class": "src.explainer.future.search.dces.DCESExplainer",
                        "parameters": {
                            "epochs": 500,
                            "projection": "index"
                        }
                    },
                    "minimizer": {
                        "class": "src.explainer.future.metaheuristic.local_search.random_hill_climbing.RandomHillClimbing",
                        "parameters": {
                            "attributed": true,
                            "manip_attr": false,
                            "max_oracle_calls": 10000,
                            "patience": 40,
                            "seed": 0
                        }
                    },
                    "generator_cache": "lab/data/cache/generator_outputs"
                }
            }
        }
    ],
    "evaluator": {
        "class": "src.evaluation.future.evaluator.Evaluator",
        "parameters": {
            "compose_pip": "./lab/config/v2/snippets/minimizing_pipeline.json"
        }
    },
    "compose_strs": "./lab/config/v2/snippets/default_store_paths.json"
}

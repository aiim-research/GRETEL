{
    "dataset": {
        "class": "src.dataset.dataset_base.Dataset",
        "parameters": {
            "generator": {
                "class": "src.dataset.generators.asd.ASD",
                "parameters": {
                    "data_dir": "data/datasets/autism/"
                }
            }
        }
    },
    "oracle": {
        "class": "src.oracle.margin.MarginOracle",
        "parameters": {
            "margin": 0.9,
            "base_oracle": {
                "class": "src.oracle.custom.oracle_asd_custom.ASDOracle",
                "parameters": {
                    "fold_id": -1,
                    "retrain": false
                }
            }
        }
    }
}
